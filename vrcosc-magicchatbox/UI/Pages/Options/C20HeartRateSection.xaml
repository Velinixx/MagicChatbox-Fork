<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.C20HeartRateSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:C20HeartRateSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                Grid.Column="0"
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_C20HeartRate, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="C20 heart rate options"
                TextOptions.TextRenderingMode="ClearType" />

            <TextBlock
                Grid.Column="1"
                Width="auto"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Cursor="Hand"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource AccentTealBrush}"
                Text="Info"
                TextDecorations="Underline" />
        </Grid>
        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_C20HeartRate, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>
                <!-- hr_bridge connection -->
                <Border Style="{StaticResource OptionCardStyle}" Width="500">
                    <StackPanel Margin="5">
                        <TextBlock
                            FontSize="15"
                            Foreground="{StaticResource TextSectionHeaderBrush}"
                            Text="hr_bridge connection"
                            TextWrapping="Wrap" />
                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="TCP Port:"
                                TextWrapping="Wrap" />
                            <TextBox
                                Width="60"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                FontFamily="Consolas"
                                Text="{Binding ModuleSettings.TcpPort, Mode=TwoWay}" />
                        </StackPanel>
                        <CheckBox
                            Margin="0,5,0,0"
                            Content="Auto-launch hr_bridge"
                            IsChecked="{Binding ModuleSettings.AutoLaunchBridge, Mode=TwoWay}"
                            Style="{DynamicResource SettingsCheckbox}" />
                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Path:"
                                TextWrapping="Wrap" />
                            <TextBox
                                Width="200"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                FontFamily="Consolas"
                                FontSize="11"
                                Text="{Binding ModuleSettings.BridgePath, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="hr_bridge (hr_bridge.exe) should be placed next to MagicChatbox.exe. Default: hr_bridge.exe in the app directory."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Embedded BLE connection -->
                <Border Style="{StaticResource OptionCardStyle}" Width="500">
                    <StackPanel Margin="5">
                        <TextBlock
                            FontSize="15"
                            Foreground="{StaticResource TextSectionHeaderBrush}"
                            Text="Embedded BLE connection"
                            TextWrapping="Wrap" />
                        <CheckBox
                            Margin="0,5,0,0"
                            Content="Use embedded BLE (no bridge app needed)"
                            IsChecked="{Binding ModuleSettings.EmbeddedBle, Mode=TwoWay}"
                            Style="{DynamicResource SettingsCheckbox}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Watch MAC:"
                                TextWrapping="Wrap" />
                            <TextBox
                                Width="130"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                FontFamily="Consolas"
                                FontSize="11"
                                Text="{Binding ModuleSettings.WatchAddress, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="10"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Embedded mode connects to the C20 directly over Windows Bluetooth, with no bridge app running. Make sure Bluetooth is enabled and Windows is allowed to use it. If the watch will not connect, wake it up (tap the screen) or restart it."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="10"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="If the watch screen sleeps it may drop the connection; MCB auto-reconnects on its own once the watch wakes and streams again."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="10"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="This mode only works on Windows. For unlocking/monitoring tricks use the hr_bridge instead."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Heart Rate Display -->
                <Border Style="{StaticResource OptionCardStyle}" Width="500">
                    <StackPanel Margin="5">
                        <TextBlock
                            FontSize="15"
                            Foreground="{StaticResource TextSectionHeaderBrush}"
                            Text="Heart Rate Number"
                            TextWrapping="Wrap" />
                        <CheckBox
                            Margin="0,5,0,0"
                            Content="Smooth heart rate"
                            IsChecked="{Binding ModuleSettings.SmoothHeartRate, Mode=TwoWay}"
                            Style="{DynamicResource SettingsCheckbox}" />
                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Smoothing window:"
                                TextWrapping="Wrap" />
                            <TextBox
                                Width="50"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                FontFamily="Consolas"
                                Text="{Binding ModuleSettings.SmoothHeartRateTimeSpan, Mode=TwoWay}" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="samples"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox
                            Margin="0,5,0,0"
                            Content="Show BPM suffix (' bpm')"
                            IsChecked="{Binding ModuleSettings.ShowBpmSuffix, Mode=TwoWay}"
                            Style="{DynamicResource SettingsCheckbox}" />
                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Heart Rate Icon:"
                                TextWrapping="Wrap" />
                            <TextBox
                                Width="40"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Text="{Binding ModuleSettings.HeartRateIcon, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Text format:"
                                TextWrapping="Wrap" />
                            <TextBox
                                Width="260"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                FontFamily="Consolas"
                                FontSize="11"
                                Text="{Binding ModuleSettings.HeartRateFormat, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="10"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Placeholders: {icon} {hr} {hrval} {min} {max} {minval} {maxval}. {min}/{max} include the superscript label, {*val} are the numbers only. Default: {icon} {hr} | {max} | {min}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Style="{StaticResource OptionCardStyle}" Width="500">
                    <StackPanel Margin="5">
                        <TextBlock
                            FontSize="15"
                            Foreground="{StaticResource TextSectionHeaderBrush}"
                            Text="Status"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextLabelBrush}"
                            TextWrapping="Wrap">
                            <Run Text="Device: " />
                            <Run
                                FontWeight="Bold"
                                Text="{Binding HasDevice, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextLabelBrush}"
                            TextWrapping="Wrap">
                            <Run Text="Heart Rate: " />
                            <Run
                                FontWeight="Bold"
                                Text="{Binding HeartRate, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextLabelBrush}"
                            TextWrapping="Wrap">
                            <Run Text="Battery: " />
                            <Run
                                FontWeight="Bold"
                                Text="{Binding Battery, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>